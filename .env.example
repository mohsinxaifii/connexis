# Copy to .env.local for local builds. In CI these come from GitHub Actions variables.

# Public site URL used for canonicals, the sitemap and structured data
VITE_SITE_URL=https://www.connexistracking.com

# Sub-path when served from github.io/<repo>/ (leave empty with a custom domain)
BASE_PATH=

# Staging only: robots.txt disallows everything. Remove at launch.
VITE_NOINDEX=

# Google Tag Manager (GA4 + Clarity), loaded with Consent Mode defaults set to denied
VITE_GTM_ID=

# Lead delivery. Web3Forms emails each demo request to the inbox tied to this access key
# (create one for sales@connexistracking.com at web3forms.com). The optional webhook gets the
# same lead as JSON (CRM, Zapier or Make, which can also ping sales on WhatsApp).
VITE_WEB3FORMS_KEY=
VITE_LEAD_WEBHOOK_URL=

# CONFIRM with Connexis
VITE_WHATSAPP=924234500786
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
